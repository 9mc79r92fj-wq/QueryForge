APP_NAME=QueryForge
APP_VERSION=1.0.0
DEBUG=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=queryforge_documents

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
RUN_MODE=local
API_REQUESTS_PER_MINUTE=600
CHAT_REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=24

# Set a unique random value of at least 32 characters for demo administration.
DEMO_ADMIN_TOKEN=
DEMO_RAG_ENABLED=false
# Lifetime provider-attempt cap for a demo deployment, backed by its SQLite volume.
DEMO_LLM_TOTAL_CALLS=0
